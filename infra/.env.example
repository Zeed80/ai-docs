# Copy to infra/.env (make setup). NEVER commit infra/.env — it is gitignored.
# Generate strong secrets with: bash infra/scripts/gen-secrets.sh
#
# Defaults below are for LOCAL DEVELOPMENT. For production see the marked block at the
# bottom — backend refuses to start in APP_ENV=production with these dev defaults.

# === Application ===
APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=dev-secret-key
APP_LOG_LEVEL=INFO
CSRF_SECRET=dev-csrf-secret
CSP_ENABLED=false

# === PostgreSQL ===
POSTGRES_USER=aiworkspace
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aiworkspace

# === MinIO ===
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=documents

# === Frontend / CORS ===
# In dev, the frontend talks to the backend directly. In prod use same-origin (via Traefik).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
CORS_ORIGINS=http://localhost:3000

# === Traefik ===
TRAEFIK_DOMAIN=localhost
TRAEFIK_ACME_EMAIL=admin@company.com

# === AI ===
AI_REASONING_BACKEND=ollama
# ANTHROPIC_API_KEY=sk-ant-...

# Local AI engines to run as part of the stack (compose profiles, comma-separated).
# Options: embedded-ollama, embedded-vllm, embedded-llamacpp. Leave empty if you
# run Ollama/vLLM externally. install.sh sets this; update.sh/backup.sh reuse it.
COMPOSE_PROFILES=embedded-ollama

# === Headless CAD kernel (FreeCAD/OpenCascade, internal in Docker) ===
CAD_KERNEL_URL=http://cad-kernel:8092
# EngineeringModelGraph primary reader rollout (legacy APIs remain derived views).
# Proven in production for "mechanical" since Ф1-2.6 (2026-08): the kernel candidate is
# always compiled back from the sealed EMG graph, never the flat spec directly. Keep true.
EMG_PIPELINE_ENABLED=true
EMG_PIPELINE_PROFILES=mechanical

# === Internal service-to-service key (AI orchestrator → backend) ===
AGENT_SERVICE_KEY=agent-internal-key-2026

# === Redis password (leave blank for dev, required in production) ===
REDIS_PASSWORD=

# === Qdrant API key (leave blank for dev, required in production) ===
QDRANT_API_KEY=

# === Trusted proxy (set true when behind Traefik/nginx, protects rate limiting) ===
TRUSTED_PROXY=false

# === Auth (Authentik SSO) ===
# Set AUTH_ENABLED=true in production to enable SSO.
AUTH_ENABLED=false
# Internal URL the backend uses for JWKS/token (Docker service name, NOT the host port).
AUTHENTIK_URL=http://authentik-server:9000
# External URL the browser is redirected to for login. Dev: http://localhost:9100.
AUTHENTIK_EXTERNAL_URL=http://localhost:9100
AUTHENTIK_SLUG=ai-workspace
OAUTH_CLIENT_ID=ai-workspace
OAUTH_CLIENT_SECRET=

# === Authentik DB / bootstrap ===
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASSWORD=authentik
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_SECRET_KEY=please-change-me-in-production
AUTHENTIK_BOOTSTRAP_EMAIL=admin@company.com
AUTHENTIK_BOOTSTRAP_PASSWORD=changeme_in_production

# === SMTP (optional) ===
# SMTP_HOST=smtp.company.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@company.com

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION — override the above. Run `bash infra/scripts/gen-secrets.sh` and paste.
# ─────────────────────────────────────────────────────────────────────────────
# APP_ENV=production
# AUTH_ENABLED=true
# CSP_ENABLED=true
# TRAEFIK_DOMAIN=yourdomain.com
# TRAEFIK_ACME_EMAIL=admin@yourdomain.com
# CORS_ORIGINS=https://yourdomain.com
# AUTHENTIK_EXTERNAL_URL=https://yourdomain.com
# NEXT_PUBLIC_API_URL=same-origin
# NEXT_PUBLIC_WS_URL=same-origin
# APP_SECRET_KEY=<gen>            CSRF_SECRET=<gen>            AGENT_SERVICE_KEY=<gen>
# POSTGRES_PASSWORD=<gen>         MINIO_SECRET_KEY=<gen>       OAUTH_CLIENT_SECRET=<gen>
# AUTHENTIK_SECRET_KEY=<gen>      AUTHENTIK_DB_PASSWORD=<gen>  AUTHENTIK_BOOTSTRAP_PASSWORD=<gen>
# REDIS_PASSWORD=<gen>            QDRANT_API_KEY=<gen>         TRUSTED_PROXY=true

# ── Почтовый сервер (Mailcow, опционально) ───────────────────────────────────
# Ставится отдельно: infra/installer/install-mailcow.sh. Пока infra/mailcow нет,
# роут mail.* в Traefik не рендерится (см. render_traefik_routes в lib.sh).
# MAIL_DOMAIN — хост вебмейла/админки (по умолчанию mail.$TRAEFIK_DOMAIN).
# MAILCOW_TAG — ЕДИНЫЙ пин релиза для install-mailcow.sh и update-mailcow.sh.
#   Актуальные теги: https://github.com/mailcow/mailcow-dockerized/releases
# MAILCOW_HTTP_PORT / MAILCOW_HTTPS_PORT — порты, на которых слушает nginx-mailcow
#   ВНУТРИ контейнера (mailcow прокидывает их внутрь) и которые публикует на
#   127.0.0.1; Traefik проксирует на MAILCOW_HTTP_PORT.
# MAIL_DOMAIN=mail.yourdomain.com
# MAILCOW_TAG=2026-07
# MAILCOW_HTTP_PORT=8080
# MAILCOW_HTTPS_PORT=8443
