{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "properties": {
        "assurance": {
          "default": "proposed",
          "enum": [
            "proposed",
            "observed",
            "corroborated",
            "constraint_validated",
            "human_approved",
            "contradicted"
          ],
          "title": "Assurance",
          "type": "string"
        },
        "confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "coordinate_system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coordinate System"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "extension": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extension"
        },
        "hypothesis_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hypothesis Id"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "impact_magnitude_percent": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Impact Magnitude Percent",
          "type": "object"
        },
        "impacts": {
          "items": {
            "enum": [
              "base_topology",
              "component_count",
              "assembly_interface",
              "mate",
              "fit",
              "interchangeability",
              "envelope",
              "connection_opening",
              "load_path",
              "structural_capacity",
              "regulatory_check",
              "connectivity",
              "required_view",
              "required_section",
              "required_dimension",
              "manufacturing_safety",
              "operational_safety",
              "material_quantity",
              "mass",
              "visual_only"
            ],
            "type": "string"
          },
          "title": "Impacts",
          "type": "array"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "origin": {
          "enum": [
            "observed",
            "traced",
            "derived",
            "standard",
            "assumed",
            "human"
          ],
          "title": "Origin",
          "type": "string"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "state": {
          "default": "active",
          "enum": [
            "active",
            "superseded",
            "retracted"
          ],
          "title": "State",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "supersedes_assertion_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Assertion Id"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "enum_set": "#/$defs/EnumSetValue",
              "exact": "#/$defs/ExactValue",
              "expression": "#/$defs/ExpressionValue",
              "interval": "#/$defs/IntervalValue",
              "unknown": "#/$defs/UnknownValue"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ExactValue"
            },
            {
              "$ref": "#/$defs/IntervalValue"
            },
            {
              "$ref": "#/$defs/EnumSetValue"
            },
            {
              "$ref": "#/$defs/ExpressionValue"
            },
            {
              "$ref": "#/$defs/UnknownValue"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "id",
        "subject_id",
        "predicate",
        "value",
        "origin"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "BuildTarget": {
      "additionalProperties": false,
      "properties": {
        "critical_impacts": {
          "items": {
            "enum": [
              "base_topology",
              "component_count",
              "assembly_interface",
              "mate",
              "fit",
              "interchangeability",
              "envelope",
              "connection_opening",
              "load_path",
              "structural_capacity",
              "regulatory_check",
              "connectivity",
              "required_view",
              "required_section",
              "required_dimension",
              "manufacturing_safety",
              "operational_safety",
              "material_quantity",
              "mass",
              "visual_only"
            ],
            "type": "string"
          },
          "title": "Critical Impacts",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "preview_brep",
            "production_step",
            "provisional_step",
            "preview_ifc",
            "production_ifc",
            "provisional_ifc",
            "stl",
            "dxf",
            "pdf"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mass_tolerance_percent": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Mass Tolerance Percent",
          "type": "number"
        },
        "requirement_ids": {
          "items": {
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        },
        "root_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Root Node Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "root_node_ids"
      ],
      "title": "BuildTarget",
      "type": "object"
    },
    "EnumSetValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "enum_set",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "values"
      ],
      "title": "EnumSetValue",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "raster_region",
            "vector_entity",
            "text",
            "dimension",
            "standard",
            "calculation",
            "trace_run",
            "visual_verification",
            "human_decision",
            "kernel_topology",
            "projection_comparison",
            "model_raw_output"
          ],
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "source_region_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Region Id"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExactValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "exact",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "items": {},
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "ExactValue",
      "type": "object"
    },
    "ExpressionValue": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "kind": {
          "const": "expression",
          "title": "Kind",
          "type": "string"
        },
        "variable_assertion_ids": {
          "items": {
            "type": "string"
          },
          "title": "Variable Assertion Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "expression"
      ],
      "title": "ExpressionValue",
      "type": "object"
    },
    "ExtensionRegistration": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "title": "Namespace",
          "type": "string"
        },
        "schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Schema Sha256",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "version",
        "schema_sha256"
      ],
      "title": "ExtensionRegistration",
      "type": "object"
    },
    "GraphEdge": {
      "additionalProperties": false,
      "properties": {
        "extension": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extension"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "contains",
            "part_of",
            "instance_of",
            "located_in",
            "represented_by",
            "same_object_across_views",
            "defines",
            "depends_on",
            "constrains",
            "applies_to",
            "mates_with",
            "connects_to",
            "opens_in",
            "generated_by",
            "maps_to_topology",
            "realizes"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "source_id",
        "target_id"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": false,
      "properties": {
        "extension": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extension"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "type": {
          "enum": [
            "DocumentSet",
            "Document",
            "Sheet",
            "View",
            "SourceRegion",
            "Product",
            "Component",
            "Feature",
            "Geometry",
            "Material",
            "Parameter",
            "Constraint",
            "System",
            "Port",
            "BuildOperation",
            "Artifact",
            "TopologyElement"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "GraphSource": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "GraphSource",
      "type": "object"
    },
    "HypothesisOption": {
      "additionalProperties": false,
      "properties": {
        "assertion_ids": {
          "items": {
            "type": "string"
          },
          "title": "Assertion Ids",
          "type": "array"
        },
        "assumption_count": {
          "default": 0,
          "minimum": 0,
          "title": "Assumption Count",
          "type": "integer"
        },
        "cross_view_consistency": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Cross View Consistency",
          "type": "number"
        },
        "domain_prior": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Domain Prior",
          "type": "number"
        },
        "evidence_coverage": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Evidence Coverage",
          "type": "number"
        },
        "hard_constraints_satisfied": {
          "default": false,
          "title": "Hard Constraints Satisfied",
          "type": "boolean"
        },
        "hybrid_trace_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Hybrid Trace Score",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "assertion_ids"
      ],
      "title": "HypothesisOption",
      "type": "object"
    },
    "HypothesisSet": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "option_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Option Ids",
          "type": "array"
        },
        "selected_option_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Option Id"
        }
      },
      "required": [
        "id",
        "option_ids"
      ],
      "title": "HypothesisSet",
      "type": "object"
    },
    "IntervalValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "interval",
          "title": "Kind",
          "type": "string"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "lower_inclusive": {
          "default": true,
          "title": "Lower Inclusive",
          "type": "boolean"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        },
        "upper_inclusive": {
          "default": true,
          "title": "Upper Inclusive",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "lower",
        "upper"
      ],
      "title": "IntervalValue",
      "type": "object"
    },
    "ReaderManifest": {
      "additionalProperties": false,
      "properties": {
        "call_timeout_seconds": {
          "default": 90,
          "minimum": 1,
          "title": "Call Timeout Seconds",
          "type": "integer"
        },
        "calls_used": {
          "default": 0,
          "minimum": 0,
          "title": "Calls Used",
          "type": "integer"
        },
        "elapsed_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Elapsed Seconds",
          "type": "number"
        },
        "max_model_calls": {
          "default": 32,
          "minimum": 1,
          "title": "Max Model Calls",
          "type": "integer"
        },
        "max_wall_seconds": {
          "default": 900,
          "minimum": 1,
          "title": "Max Wall Seconds",
          "type": "integer"
        },
        "no_progress_pass_limit": {
          "default": 2,
          "minimum": 1,
          "title": "No Progress Pass Limit",
          "type": "integer"
        },
        "no_progress_passes": {
          "default": 0,
          "minimum": 0,
          "title": "No Progress Passes",
          "type": "integer"
        },
        "ordinary_attempts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Ordinary Attempts",
          "type": "object"
        },
        "stop_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        }
      },
      "title": "ReaderManifest",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "assertion_ids": {
          "items": {
            "type": "string"
          },
          "title": "Assertion Ids",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "topology",
            "interface",
            "envelope",
            "load",
            "connectivity",
            "view",
            "section",
            "dimension",
            "safety",
            "quantity",
            "mass",
            "domain"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mandatory": {
          "default": true,
          "title": "Mandatory",
          "type": "boolean"
        },
        "target_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Target Node Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "UnknownValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unknown",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "kind"
      ],
      "title": "UnknownValue",
      "type": "object"
    },
    "VerificationState": {
      "additionalProperties": false,
      "properties": {
        "build": {
          "default": "not_ready",
          "enum": [
            "not_ready",
            "preview_ready",
            "preview_built",
            "verified"
          ],
          "title": "Build",
          "type": "string"
        },
        "checked_levels": {
          "items": {
            "type": "integer"
          },
          "title": "Checked Levels",
          "type": "array"
        },
        "comprehension": {
          "default": "accumulating",
          "enum": [
            "accumulating",
            "converged",
            "contradictory",
            "review_needed"
          ],
          "title": "Comprehension",
          "type": "string"
        },
        "critical_unresolved_assertion_ids": {
          "items": {
            "type": "string"
          },
          "title": "Critical Unresolved Assertion Ids",
          "type": "array"
        },
        "issue_codes": {
          "items": {
            "type": "string"
          },
          "title": "Issue Codes",
          "type": "array"
        },
        "release": {
          "default": "blocked",
          "enum": [
            "blocked",
            "approved",
            "certified"
          ],
          "title": "Release",
          "type": "string"
        }
      },
      "title": "VerificationState",
      "type": "object"
    }
  },
  "$id": "https://schemas.ptsai.local/emg/engineering-model-graph-1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assertions": {
      "items": {
        "$ref": "#/$defs/Assertion"
      },
      "title": "Assertions",
      "type": "array"
    },
    "build_targets": {
      "items": {
        "$ref": "#/$defs/BuildTarget"
      },
      "title": "Build Targets",
      "type": "array"
    },
    "canonical_sha256": {
      "default": "",
      "title": "Canonical Sha256",
      "type": "string"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/GraphEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "extension_registry": {
      "items": {
        "$ref": "#/$defs/ExtensionRegistration"
      },
      "title": "Extension Registry",
      "type": "array"
    },
    "graph_id": {
      "title": "Graph Id",
      "type": "string"
    },
    "hypothesis_options": {
      "items": {
        "$ref": "#/$defs/HypothesisOption"
      },
      "title": "Hypothesis Options",
      "type": "array"
    },
    "hypothesis_sets": {
      "items": {
        "$ref": "#/$defs/HypothesisSet"
      },
      "title": "Hypothesis Sets",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/GraphNode"
      },
      "title": "Nodes",
      "type": "array"
